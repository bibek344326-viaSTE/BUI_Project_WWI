          },
          {
            "name": "Quantity",
            "dataType": "int64",
            "sourceColumn": "Quantity",
            "sourceProviderType": "Integer"
          },
          {
            "name": "Unit Price",
            "dataType": "double",
            "sourceColumn": "Unit Price",
            "sourceProviderType": "Numeric"
          },
          {
            "name": "Tax Rate",
            "dataType": "double",
            "sourceColumn": "Tax Rate",
            "sourceProviderType": "Numeric"
          },
          {
            "name": "Total Excluding Tax",
            "dataType": "double",
            "sourceColumn": "Total Excluding Tax",
            "sourceProviderType": "Numeric"
          },
          {
            "name": "Tax Amount",
            "dataType": "double",
            "sourceColumn": "Tax Amount",
            "sourceProviderType": "Numeric"
          },
          {
            "name": "Total Including Tax",
            "dataType": "double",
            "sourceColumn": "Total Including Tax",
            "sourceProviderType": "Numeric"
          },
          {
            "name": "Lineage Key",
            "dataType": "int64",
            "sourceColumn": "Lineage Key",
            "sourceProviderType": "Integer"
          },
          {
            "type": "calculated",
            "name": "Order Completion Date",
            "dataType": "dateTime",
            "expression": [
              "",
              "VAR LineCount =",
              "    CALCULATE(",
              "        COUNTROWS('Orders'),",
              "        ALLEXCEPT('Orders', 'Orders'[WWI Order ID])",
              "    )",
              "VAR PickedLineCount =",
              "    CALCULATE(",
              "        COUNT('Orders'[Picked Date Key]),",
              "        ALLEXCEPT('Orders', 'Orders'[WWI Order ID])",
              "    )",
              "RETURN",
              "    IF(",
              "        LineCount = PickedLineCount,",
              "        CALCULATE(",
              "            MAX('Orders'[Picked Date Key]),",
              "            ALLEXCEPT('Orders', 'Orders'[WWI Order ID])",
              "        ),",
              "        BLANK()",
              "    )"
            ],
            "formatString": "General Date"
          },
          {
            "type": "calculated",
            "name": "Picking Days",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": [
              "IF(",
              "    ISBLANK('Orders'[Order Completion Date]),",
              "    BLANK(),",
              "    DATEDIFF('Orders'[Order Date Key], 'Orders'[Order Completion Date], DAY)",
              ")"
            ]
          }
        ],
        "partitions": [
          {
            "name": "Order",
            "dataView": "full",
            "source": {
              "type": "query",
              "query": " \t\t\t\tSELECT [Fact].[Order].*   FROM [Fact].[Order] ",
              "dataSource": "SqlServer Bibek WideWorldImportersDW"
            }
          }
        ],
        "measures": [
          {
            "name": "Order Count",
            "expression": "DISTINCTCOUNT([WWI Order ID])"
          },
          {
            "name": "Ordered Quantity",
            "expression": " SUM('Orders'[Quantity])"
          },
          {
            "name": "Average Order Value",
            "expression": " DIVIDE([Order Value Excl. Tax], [Order Count])"
          },
          {
            "name": "Order Count YTD",
            "expression": [
              "",
              "CALCULATE(",
              "    [Order Count],",
              "    DATESYTD('Date'[Date])",
              ")"
            ]
          },
          {
            "name": "Order Value Excl. Tax",
            "expression": " SUM('Orders'[Total Excluding Tax])"
          },
          {
            "name": "Orders per Customer",
            "expression": [
              "",
              "DIVIDE(",
              "    [Order Count],",
              "    COUNTROWS(SUMMARIZE('Orders', 'Customer'[WWI Customer ID]))",
              ")"
            ]
          },
          {
            "name": "Orders with Backorder Reference",
            "expression": [
              "",
              "CALCULATE(",
              "    [Order Count],",
              "    KEEPFILTERS(NOT ISBLANK('Orders'[WWI Backorder ID]))",
              ")"
            ]
          },
          {
            "name": "Picking Completion Rate",
            "expression": [
              "",
              "DIVIDE([Picked Orders], [Order Count])"
            ],
            "formatString": "0.00 %;-0.00 %;0.00 %"
          },
          {
            "name": "Average Picking Days",
            "expression": [
              "",
              "AVERAGEX(",
              "    VALUES('Orders'[WWI Order ID]),",
              "    CALCULATE(MAX('Orders'[Picking Days]))",
              ")"
            ]
          },
          {
            "name": "Picked Orders",
            "expression": [
              "",
              "CALCULATE(",
              "    [Order Count],",
              "    KEEPFILTERS(NOT ISBLANK('Orders'[Order Completion Date]))",
              ")"
            ]
          },
          {
            "name": "Orders with Unpicked Lines",
            "expression": [
              "",
              "CALCULATE(",
              "    [Order Count],",
              "    KEEPFILTERS(ISBLANK('Orders'[Order Completion Date]))",
              ")"
            ]
          },
          {
            "name": "Unpicked Quantity",
            "expression": [
              "",
              "CALCULATE(",
              "    SUM('Orders'[Quantity]),",
              "    KEEPFILTERS(ISBLANK('Orders'[Picked Date Key]))",
              ")"
            ]
          }
        ],
        "annotations": [
          {
            "name": "_TM_ExtProp_QueryDefinition",
            "value": " \t\t\t\tSELECT [Fact].[Order].*   FROM [Fact].[Order] "
          },
          {
            "name": "_TM_ExtProp_DbTableName",
            "value": "Order"
          },
          {
            "name": "_TM_ExtProp_DbSchemaName",
            "value": "Fact"
          }
        ]
