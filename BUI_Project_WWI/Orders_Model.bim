            "sourceProviderType": "Integer"
          },
          {
            "type": "calculated",
            "name": "Order Completion Date",
            "dataType": "dateTime",
            "expression": [
              "",
              "VAR LineCount =",
              "    CALCULATE(",
              "        COUNTROWS('Orders'),",
              "        ALLEXCEPT('Orders', 'Orders'[WWI Order ID])",
              "    )",
              "VAR PickedLineCount =",
              "    CALCULATE(",
              "        COUNT('Orders'[Picked Date Key]),",
              "        ALLEXCEPT('Orders', 'Orders'[WWI Order ID])",
              "    )",
              "RETURN",
              "    IF(",
              "        LineCount = PickedLineCount,",
              "        CALCULATE(",
              "            MAX('Orders'[Picked Date Key]),",
              "            ALLEXCEPT('Orders', 'Orders'[WWI Order ID])",
              "        ),",
              "        BLANK()",
              "    )"
            ],
            "formatString": "General Date"
          },
          {
            "type": "calculated",
            "name": "Picking Days",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": [
              "IF(",
              "    ISBLANK('Orders'[Order Completion Date]),",
              "    BLANK(),",
              "    DATEDIFF('Orders'[Order Date Key], 'Orders'[Order Completion Date], DAY)",
              ")"
            ]
          }
        ],
